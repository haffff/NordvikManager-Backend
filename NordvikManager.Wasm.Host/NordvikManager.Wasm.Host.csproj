<Project Sdk="Microsoft.NET.Sdk">

  <!-- The browser-wasm GM host: WasmHost (NordvikManager.Wasm.Hosting) in a browser tab's worker,
       with the GM's page and the self-check (?selfcheck, see README.md). Not in the solution:
       browser-wasm needs the wasm-tools workload. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Browser-wasm turns reflection-based System.Text.Json off by default; the shared
         layers use it. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Links SQLite (SQLitePCLRaw's e_sqlite3.a) into the runtime: games are kept in a SQLite file. -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- MediatR, the handler/step scans, EF Core and Jint work by reflection. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- The page (main.js, gm-page.js, page-bridge.js, the real WebRTC module) and its worker
       (host-worker.js, worker-bridge.js, opfs-fs.js, stand-ins for the page's modules). -->
  <ItemGroup>
    <WasmExtraFilesToDeploy Include="index.html" />
    <!-- Listed here, not as WasmMainJSPath: that one isn't an input of the bundle step, so a change to
         main.js alone wasn't deployed. -->
    <WasmExtraFilesToDeploy Include="main.js" />
    <WasmExtraFilesToDeploy Include="gm-page.js" />
    <WasmExtraFilesToDeploy Include="page-bridge.js" />
    <WasmExtraFilesToDeploy Include="host-worker.js" />
    <WasmExtraFilesToDeploy Include="worker-bridge.js" />
    <WasmExtraFilesToDeploy Include="opfs-fs.js" />
    <WasmExtraFilesToDeploy Include="nordvik-webrtc-worker.js" />
    <WasmExtraFilesToDeploy Include="SelfCheck\selfcheck-player.js" Link="selfcheck-player.js" />
    <WasmExtraFilesToDeploy Include="SelfCheck\selfcheck-player-worker.js" Link="selfcheck-player-worker.js" />
    <WasmExtraFilesToDeploy Include="..\NordvikManager.Wasm.WebRtc\Interop\nordvik-webrtc.js" />
  </ItemGroup>

  <!-- The native server's built-in addons (Basics), in the runtime's filesystem at
       /BuiltInAddons/: AppContext.BaseDirectory is "/" in a browser, so BuiltInAddons finds them
       where it does natively, next to the program. -->
  <ItemGroup>
    <WasmFilesToIncludeInFileSystem Include="..\NordvikManager\BuiltInAddons\**\*" TargetPath="BuiltInAddons\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NordvikManager.Wasm.Hosting\NordvikManager.Wasm.Hosting.csproj" />
  </ItemGroup>

</Project>
