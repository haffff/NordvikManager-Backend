<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SQLite only: other databases (MySQL in the native server) are the host's, passed to
       InfrastructureLayerModule.Register, so a browser-wasm host doesn't carry them. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NordvikManager.Domain\NordvikManager.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Initializers\" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddonRepositoryService's HttpClient constructor, for the readme tests. -->
    <InternalsVisibleTo Include="NordvikManager.Application.UnitTests" />
  </ItemGroup>

</Project>
