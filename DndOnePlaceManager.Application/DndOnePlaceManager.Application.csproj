<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Mapperly (Mapping/AppMapper.cs): a target member nothing maps to fails the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);RMG012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Commands\Actions\AddAction\" />
    <Folder Include="Commands\Addons\SwitchAddonState\" />
    <Folder Include="Commands\Auth\" />
    <Folder Include="Commands\Properties\GetProperty\" />
    <Folder Include="Commands\Properties\AddProperty\" />
    <Folder Include="Commands\Properties\RemoveProperty\" />
    <Folder Include="Commands\Properties\UpdateProperty\" />
  </ItemGroup>

  <ItemGroup>
    <!-- MediatR 13+ is commercial (a license key per installation); 11 is Apache-2.0. Do not upgrade. -->
    <PackageReference Include="MediatR" Version="[11.0.0]" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="11.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <!-- The main SkiaSharp package only bundles native binaries for Windows/macOS by default —
         Linux needs this opt-in explicitly, or SkiaSharp throws DllNotFoundException at runtime
         (this is what broke thumbnail generation on the ubuntu-latest CI runner). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="DNDOnePlaceManager.Application.Tests" />
    <InternalsVisibleTo Include="DndOnePlaceManager.Application.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DndOnePlaceManager.Domain\DndOnePlaceManager.Domain.csproj" />
    <ProjectReference Include="..\DndOnePlaceManager.Infrastructure\DndOnePlaceManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
