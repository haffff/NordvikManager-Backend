{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "FrontUrls": {
    "Client": "http://localhost:3000,http://localhost:3001,http://localhost:3002"
  },
  "JWT": {
    "ExpireHours": 3
  },
  "CentralServerUrl": "http://localhost:3000",
  "UseSqlite": true,
  "ConnectionStrings": {
    "DBData": "Data Source=.\\data.db"
  },
  "FileStorage": {
    "BasePath": "./data/storage"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8213"
      },
      "Https": {
        "Url": "https://localhost:8214"
      }
    }
  },
  "WebRTC": {
    // Fallback STUN servers — only used when the Central Server /api/ice-servers endpoint is unreachable.
    // STUN/TURN are configured on the Central Server (STUN_SERVERS, TURN_URLS, TURN_SECRET).
    "StunServers": [ "stun:stun.l.google.com:19302" ]
  },
  "AddonsConfiguration": {
    "MainRepository": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/addons.json",
    "FeaturedAddons": [
      "dnd5e"
    ]
  },
  "LocalAdmins": {
    "AutoPromoteFirstUser": true,
    "UserIds": [],
    "Emails": []
  }
}
