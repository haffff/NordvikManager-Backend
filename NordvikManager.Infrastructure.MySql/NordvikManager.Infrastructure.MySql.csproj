<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MySQL database, an infrastructure adapter of its own so only the hosts that offer
       MySQL (the native server) carry its packages; a browser-wasm host reaches
       NordvikManager.Infrastructure but not this. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.1" />
  </ItemGroup>

</Project>
