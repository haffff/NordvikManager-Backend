{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "setup",
  "prefix": "sanity",
  "description": "Player Load: adds the example tools (Tools panel) and the Sanity menu for the player who loads the game; GMs (owner and co-GMs) also get the GM ones.",
  "hook": 5,
  "isEnabled": true,
  "content": [
    {
      "id": "c28099eb-7077-50c9-9a64-8709217635ce",
      "Type": "AddMapTool",
      "Data": {
        "Label": "Tool: mark up to 3 targets",
        "Name": "sanity_target",
        "UiName": "Mark targets",
        "Action": "sanity/toggle_target",
        "Target": "token",
        "StayActive": true,
        "OnlyOwner": true,
        "Hint": "Click tokens to mark up to 3 targets; click a marked one to unmark it.",
        "ActionArgs": {
          "maxTargets": "3"
        }
      }
    },
    {
      "id": "f3283248-7ed3-5385-ae83-ad4d662c86f5",
      "Type": "AddMapTool",
      "Data": {
        "Label": "Tool: Fireball",
        "Name": "sanity_fireball",
        "UiName": "Fireball",
        "Action": "sanity/fireball",
        "Target": "point",
        "StayActive": false,
        "OnlyOwner": true,
        "Hint": "Click where the Fireball explodes (20 ft radius).",
        "ActionArgs": {
          "radiusSquares": "4",
          "dice": "8d6"
        }
      }
    },
    {
      "id": "7555f5cb-6cd0-5833-bda1-7615b1444e79",
      "Type": "AddToolbarButton",
      "Data": {
        "Label": "Toolbar menu",
        "Name": "sanity_menu",
        "UiName": "Sanity",
        "MenuId": "sanity_menu",
        "MenuName": "Sanity",
        "OnlyOwner": true
      }
    },
    {
      "id": "27adfe46-b403-5b58-9e57-c03f74bca10c",
      "Type": "AddMenuItem",
      "Data": {
        "Label": "Menu: Bless",
        "Name": "sanity_bless",
        "UiName": "Bless the marked targets",
        "Action": "sanity/bless",
        "Location": "sanity_menu",
        "OnlyOwner": true
      }
    },
    {
      "id": "a2bd7095-0a8f-5d93-80f1-1c56990cad6b",
      "Type": "AddMenuItem",
      "Data": {
        "Label": "Menu: clear targets",
        "Name": "sanity_clear",
        "UiName": "Clear marked targets",
        "Action": "sanity/clear_targets",
        "Location": "sanity_menu",
        "OnlyOwner": true
      }
    },
    {
      "id": "1d41fbd9-795a-5208-88c2-4688c50ae34c",
      "Type": "RequirePermission",
      "Data": {
        "Label": "Is this player a GM (Edit on the game)?",
        "EntityId": "%gameId%",
        "Permission": "Edit",
        "Output": "sg_isGm",
        "StopIfDenied": false
      }
    },
    {
      "id": "fcebfa86-9211-56ff-a01f-95997738257f",
      "Type": "If",
      "Data": {
        "Label": "GM tools for GMs",
        "Condition": "'%sg_isGm%' = 'True'",
        "ActionTrue": "sanity/setup_gm",
        "ActionFalse": ""
      }
    }
  ]
}
