{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "random_enemy",
  "prefix": "sanity",
  "description": "Map right-click: places a copy of a random card that has the property 'potworny'.",
  "hook": 0,
  "isEnabled": false,
  "content": [
    {
      "id": "3e243ea2-fd2c-5d94-9f06-b87329755588",
      "Type": "RequirePermission",
      "Data": {
        "Label": "GMs only",
        "EntityId": "%gameId%",
        "Permission": "Edit",
        "StopIfDenied": true
      }
    },
    {
      "id": "5231358a-c57c-592e-b17f-b9d345b31dad",
      "Type": "GetData",
      "Data": {
        "Label": "Cards with the property",
        "Type": "Card",
        "PropertyName": "potworny",
        "Output": "re_cards"
      }
    },
    {
      "id": "76f28bb5-eb44-5a93-a2b4-16c996dfa786",
      "Type": "RunScript",
      "Data": {
        "Label": "The pool (not the copies this action made)",
        "Output": "",
        "Script": "var cards = vars.re_cards || [];\nvar ids = {};\ncards.forEach(function (c) { ids[String(c.Id)] = true; });\nvar pool = cards.filter(function (c) { return !(c.TemplateId && ids[String(c.TemplateId)]); })\n                .map(function (c) { return { id: String(c.Id), name: c.Name }; });\nreturn { re_pool: pool, re_count: pool.length };"
      }
    },
    {
      "id": "eeca2b65-f50a-5271-83d5-c20c58625f4a",
      "Type": "If",
      "Data": {
        "Label": "Any to choose from?",
        "Condition": "%re_count% = 0",
        "Then": [
          {
            "id": "dcc9d5ae-6d3c-5b1b-ad49-34167c7a73d1",
            "Type": "SendChat",
            "Data": {
              "Label": "Tell the GM",
              "Template": "Text",
              "Title": "Random monster",
              "Player": "%playerId%",
              "Message": "No card has the property 'potworny'. Add it (any value) to the cards to pick from."
            }
          }
        ],
        "Else": [
          {
            "id": "2c4e42e4-59cc-5f47-b8f0-ca608b4fbf43",
            "Type": "RollDice",
            "Data": {
              "Label": "Pick one",
              "DiceString": "1d%re_count%",
              "OutputVariable": "re_roll",
              "SimpleOutput": true
            }
          },
          {
            "id": "5bb5e1f7-7d54-5a21-8575-b58e42373c50",
            "Type": "RunScript",
            "Data": {
              "Label": "The picked card",
              "Output": "",
              "Script": "var p = vars.re_pool[Number(vars.re_roll) - 1];\nreturn { re_id: p.id, re_name: p.name };"
            }
          },
          {
            "id": "9a8a8d61-1262-5a83-971a-22e3ceac5c40",
            "Type": "CreateCard",
            "Data": {
              "Label": "A copy of it",
              "Name": "%re_name%",
              "TemplateId": "%re_id%",
              "Output": "re_newCard"
            }
          },
          {
            "id": "fb4a81b8-56cf-5ab3-8305-fd1f4e617f59",
            "Type": "RunClientCommand",
            "Data": {
              "Label": "Its token where the map was clicked",
              "Panel": "BattleMap_token",
              "Command": "CreateToken",
              "Player": "%playerId%",
              "Data": "{\"contextId\": \"%battleMapId%\", \"cardId\": \"%re_newCard%\", \"position\": %position%}"
            }
          },
          {
            "id": "3bec3fd2-5a82-5c99-815c-67a5b5772989",
            "Type": "SendChat",
            "Data": {
              "Label": "Announce",
              "Template": "Text",
              "Title": "Random monster",
              "Message": "A wild %re_name% appears!"
            }
          }
        ]
      }
    }
  ],
  "gmPermission": 31
}
